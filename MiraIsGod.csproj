<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
  <OutputType>WinExe</OutputType>
  <TargetFramework>net48</TargetFramework>
  <LangVersion>latest</LangVersion>
  <AssemblyName>MiraIsGodInstaller</AssemblyName>
  <RootNamespace>MiraIsGodInstaller</RootNamespace>
  <!-- 埋め込むプラグインの DLL の場所 (ビルドのときに変えられる) -->
  <PluginDll Condition="'$(PluginDll)' == ''">../out/MiraIsGod.dll</PluginDll>
</PropertyGroup>
  <ItemGroup>
    <!-- installer フォルダはインストーラー用なので、プラグインには入れない -->
    <Compile Remove="Installer/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AmongUs.GameLibs.Steam" Version="2026.9.29" PrivateAssets="all" />
    <PackageReference Include="NextBepLoader.BepInEx.IL2CPP.MSBuild" Version="2.1.0-dev-6" />
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.785" Private="false" ExcludeAssets="runtime;native" />
    <PackageReference Include="Samboy063.Cpp2IL.Core" Version="2022.1.0-pre-release.21" />
  </ItemGroup>
</Project>
